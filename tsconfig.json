{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "noImplicitAny": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "strict": false,
    "strictNullChecks": false,
    "lib": ["DOM", "ES2018"],
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
